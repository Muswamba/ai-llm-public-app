# Provider-neutral LLM backend configuration.
# Leave these blank to use the built-in mock backend for the tutorial.

# LLM_BASE_URL should point to an OpenAI-compatible /v1 API root.
# Examples:
# - OpenAI: https://api.openai.com/v1
# - Ollama local: http://localhost:11434/v1
# - OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=""

# Secret key for your provider. Never expose this in frontend code.
# For local Ollama, you can use any placeholder value if your endpoint does not enforce auth.
LLM_API_KEY=""

# Model name from your provider.
# Examples: gpt-4o-mini, llama3.2, deepseek-chat, mistralai/mistral-small
LLM_MODEL="mock-backend"

# Low values are more consistent for teaching and demos.
LLM_TEMPERATURE="0.3"

# Express server port.
PORT="8787"
